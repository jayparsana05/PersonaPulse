# ============================================================
# PersonaPulse – Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the filled .env file to version control.
# ============================================================

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Used for: LLM drafting (gemini-3.6-flash) + embeddings (gemini-embedding-001)
# Get it at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite

# ── Tavily Search ─────────────────────────────────────────────────────────────
# Used for: Discovering trending tech news articles
# Get it at: https://app.tavily.com/
# DISCOVERY_CANDIDATE_COUNT: max topic candidates returned per discovery run (default 5)
TAVILY_API_KEY=
DISCOVERY_CANDIDATE_COUNT=5

# ── Supabase ──────────────────────────────────────────────────────────────────
# Used for: Vector deduplication (pgvector), post storage, style profile
# Find at: Supabase Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram ──────────────────────────────────────────────────────────────────
# Used for: Sending approval alerts with inline approve/reject buttons
# TELEGRAM_BOT_TOKEN:      Get from @BotFather on Telegram
# TELEGRAM_CHAT_ID:        Your personal chat ID (use @userinfobot to find it) - Layer 2 Check
# TELEGRAM_WEBHOOK_SECRET: Optional secret token for Layer 1 Check [a-zA-Z0-9_-]{1,256}
#                          (If omitted, automatically derived from TELEGRAM_BOT_TOKEN via SHA-256)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ── LinkedIn ──────────────────────────────────────────────────────────────────
# Used for: Publishing UGC posts and uploading images
# LINKEDIN_CLIENT_ID:         OAuth 2.0 Client ID (from LinkedIn Developer Portal)
# LINKEDIN_CLIENT_SECRET:     OAuth 2.0 Client Secret
# LINKEDIN_ACCESS_TOKEN:      OAuth 2.0 access token (3-legged flow)
# LINKEDIN_AUTHOR_URN:        e.g. urn:li:person:XXXXXXXXXX
# LINKEDIN_TOKEN_EXPIRY_DATE: Token expiry in YYYY-MM-DD format (for canary check)
# Get at: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_TOKEN_EXPIRY_DATE=    # YYYY-MM-DD, e.g. 2025-12-31

# ── X (Twitter) ───────────────────────────────────────────────────────────────
# Used for: Publishing tweets via X API v2 (OAuth 1.0a User Context)
# Requires "Read and Write" permissions in the X Developer Portal.
# Get at: https://developer.twitter.com/en/portal/dashboard
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
